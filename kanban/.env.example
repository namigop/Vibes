# --- Postgres (container) ---
# These defaults match backend/internal/config/config.go's defaultDatabaseURL
# and the credentials the existing pgdata volume was created with. Changing
# them does NOT affect an already-initialised volume — see the note in
# docker-compose.yml.
POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban
POSTGRES_DB=kanban
# Published on the host. 5432 is taken by a native Postgres install, so the
# container publishes 5433. Containers on the compose network use 5432.
POSTGRES_PORT=5433

# --- Backend ---
# When running the backend on the host against the container, use the published
# port above. When running it inside compose, the default in config.go is
# already correct and you can leave DATABASE_URL unset.
DATABASE_URL=postgres://kanban:kanban@localhost:5433/kanban?sslmode=disable
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
SEED_DEMO=true
APP_ENV=development

# --- Auth ---
# Signs and verifies bearer tokens. In development the server falls back to a
# built-in default (and logs a warning). Setting APP_ENV=production with the
# default still set makes the server REFUSE TO START.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
# How long an issued token stays valid. Tokens are stateless and cannot be
# revoked, so this is the ceiling on how long a leaked token is useful.
JWT_TTL=24h
# Shared password for every seeded demo account (alice, bob, carol, demo,
# legacy). Setting APP_ENV=production while this is the default also refuses
# to start.
DEMO_PASSWORD=kanban-demo

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
FRONTEND_PORT=3000