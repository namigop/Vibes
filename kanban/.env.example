# --- Postgres (container) ---
POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban
POSTGRES_DB=kanban
# 5432 is frequently taken by a native Postgres install, so the container
# publishes 5433 by default.
POSTGRES_PORT=5433

# --- Backend ---
# When running the backend on the host against the container, use the published
# port above. When running the backend inside compose, use `postgres:5432`.
DATABASE_URL=postgres://kanban:kanban@localhost:5433/kanban?sslmode=disable
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
SEED_DEMO=true
APP_ENV=development

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
FRONTEND_PORT=3000
