# Postgres (used by docker-compose for the database service)
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo
POSTGRES_PORT=5432

# Backend (consumed inside the backend container)
# Matches POSTGRES_* above.
DATABASE_URL=postgres://todo:todo@postgres:5432/todo?sslmode=disable
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend (consumed inside the frontend container, exposed to the browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
